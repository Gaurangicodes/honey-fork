# Copy to .env and fill in. Never commit a real .env.

# Backend / frontend ports
BACKEND_PORT=8123
FRONTEND_PORT=5173

# Local EVM / Anvil RPC endpoint (only used when the Anvil adapter is selected)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Evidence storage location (SQLite file)
EVIDENCE_DB_PATH=data/agentcrash.db

# Default transaction limit, in smallest token units (1000 * 10^18)
DEFAULT_MAX_TRANSACTION_AMOUNT=1000000000000000000000

# Default number of trials per attack
DEFAULT_REPEAT_COUNT=1

# LLM provider (only needed once the agent runtime calls a real model)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Optional ecosystem adapters (SRS 20.6, FR-INT-01..05)
#
# Every adapter is OFF by default and the core attack -> policy -> replay proof
# runs unchanged with all of them disabled. Enabling an adapter is opt-in: set
# its flag to 1. Setting a credential alone does not turn anything on.
#
# When an adapter is enabled but not fully configured, it reports
# "not_configured" and its calls return "not run" rather than an empty success.
# Nothing here fabricates a result.
#
# Set AGENTCRASH_INTEGRATIONS_ENABLED=0 to force every adapter off at once.
# ---------------------------------------------------------------------------
AGENTCRASH_INTEGRATIONS_ENABLED=1

# Socket.dev — dependency/supply-chain preflight (P1). Read-only.
# AGENTCRASH_INTEGRATION_SOCKET=1
# SOCKET_API_TOKEN=
# SOCKET_ORG_SLUG=
# SOCKET_API_URL=https://api.socket.dev

# TigerGraph — optional attack-path graph backend (P1). The local graph is the
# baseline and always works; this only adds a queryable copy of observed events.
# AGENTCRASH_INTEGRATION_TIGERGRAPH=1
# TIGERGRAPH_HOST=http://localhost:14240
# TIGERGRAPH_USERNAME=
# TIGERGRAPH_PASSWORD=
# TIGERGRAPH_GRAPH=agentcrash
# TIGERGRAPH_TOKEN=

# Wispr Flow — voice-to-command input (P1). No public API: dictation arrives as
# text and every command needs confirmation. Voice can never approve a policy or
# authorise a transfer.
# AGENTCRASH_INTEGRATION_WISPRFLOW=1
# WISPRFLOW_SOURCE=client

# Dodo Payments — future hosted SaaS billing (P2). Read-only usage metering;
# there is no checkout or charge path in this MVP.
# AGENTCRASH_INTEGRATION_DODO=1
# DODO_PAYMENTS_API_KEY=dodo_test_...
# DODO_PAYMENTS_MODE=test
# DODO_PAYMENTS_API_URL=https://test.dodopayments.com
